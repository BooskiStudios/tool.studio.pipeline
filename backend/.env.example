# Booski Core settings for running on your own machine (not Docker).
# `uv run booski devdb setup` creates backend/.env with working values, so you rarely need this file.
# backend/.env is git-ignored: never commit real passwords.

# development | test | production  (production hides /api/docs)
BOOSKI_ENVIRONMENT=development

# Any PostgreSQL 18 server. Locally: the one `booski devdb` runs. In the cloud: your managed database.
BOOSKI_DATABASE_URL=postgresql+psycopg://booski:<password>@127.0.0.1:55432/booski

# Database the tests may wipe. The name must end in _test.
BOOSKI_TEST_DATABASE_URL=postgresql+psycopg://booski:<password>@127.0.0.1:55432/booski_test

BOOSKI_LOG_LEVEL=INFO

# AI provider key for the whole server (PR 3.2). Leave unset and every AI request is blocked.
# Keep the real key only in backend/.env (git-ignored) or a secret store: never commit it.
# BOOSKI_ANTHROPIC_API_KEY=
# BOOSKI_AI_REQUEST_TIMEOUT_SECONDS=120
# BOOSKI_AI_MAX_RETRIES=2
